# Public project identifiers (safe for the browser; security is enforced by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
# Server-only. Required solely for verified account deletion.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Server-only AI credential. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional: override the default cost-efficient stable model.
# GEMINI_MODEL=gemini-3.1-flash-lite
